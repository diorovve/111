CreateToggle("Auto Kill (Selected)", "AutoKill", function(state)
    if state and not Running.AutoKill then
        Running.AutoKill = true
        task.spawn(function()
            while Config.AutoKill do
                task.wait(0.15)
                -- цель: залоченные игроки, если есть; иначе ближайший в радиусе
                local targets = {}
                if #Config.LockedPlayers > 0 then
                    for _, p in ipairs(Config.LockedPlayers) do
                        table.insert(targets, p)
                    end
                else
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character then
                                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                                if tHrp and (tHrp.Position - hrp.Position).Magnitude <= Config.AutoKillRange then
                                    table.insert(targets, p)
                                end
                            end
                        end
                    end
                end

                for _, p in ipairs(targets) do
                    local c = p.Character
                    if c then
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            -- путь 1: прямая установка Health (клиентский kill)
                            pcall(function() hum.Health = 0 end)
                            -- путь 2: TakeDamage (некоторые игры читают это)
                            pcall(function() hum:TakeDamage(hum.Health + 100) end)
                            -- путь 3: BreakJoints (фолбэк, разваливает персонажа)
                            pcall(function() c:BreakJoints() end)
                        end
                    end
                end
            end
            Running.AutoKill = false
        end)
    end
end)
